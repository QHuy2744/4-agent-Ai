### 3. Mã nguồn `app.js` (Logic: Tạo, Xem, Sửa, Xóa)
```javascript
// Khởi chạy hiển thị danh sách khi tải trang
document.addEventListener('DOMContentLoaded', renderNotes);

// Lấy danh sách ghi chú từ localStorage
function getNotes() {
    let notes = localStorage.getItem('notes');
    return notes ? JSON.parse(notes) : [];
}

// Lưu danh sách ghi chú vào localStorage
function saveNotesToStorage(notes) {
    localStorage.setItem('notes', JSON.stringify(notes));
}

// Thêm hoặc Cập nhật Ghi Chú
function saveNote() {
    const id = document.getElementById('note-id').value;
    const title = document.getElementById('note-title').value.trim();
    const content = document.getElementById('note-content').value.trim();

    if (!title || !content) {
        alert('Vui lòng nhập đầy đủ tiêu đề và nội dung!');
        return;
    }

    let notes = getNotes();

    if (id === "") {
        // Tạo mới (Create)
        const newNote = {
            id: Date.now().toString(),
            title: title,
            content: content
        };
        notes.push(newNote);
    } else {
        // Sửa (Update)
        notes = notes.map(note => {
            if (note.id === id) {
                return { ...note, title: title, content: content };
            }
            return note;
        });
    }

    saveNotesToStorage(notes);
    resetForm();
    renderNotes();
}

// Xem / Hiển thị danh sách ghi chú (Read)
function renderNotes() {
    const notesList = document.getElementById('notes-list');
    const notes = getNotes();

    if (notes.length === 0) {
        notesList.innerHTML = '<p style="text-align: center; color: #777;">Chưa có ghi chú nào.</p>';
        return;
    }

    notesList.innerHTML = '';
    notes.forEach(note => {
        const card = document.createElement('div');
        card.className = 'note-card';
        card.innerHTML = `
            <h3>${escapeHTML(note.title)}</h3>
            <p>${escapeHTML(note.content)}</p>
            <div class="note-actions">
                <button class="btn-edit" onclick="editNote('${note.id}')">Sửa</button>
                <button class="btn-delete" onclick="deleteNote('${note.id}')">Xóa</button>
            </div>
        `;
        notesList.appendChild(card);
    });
}

// Chuẩn bị dữ liệu lên form để sửa
function editNote(id) {
    const notes = getNotes();
    const note = notes.find(n => n.id === id);

    if (note) {
        document.getElementById('note-id').value = note.id;
        document.getElementById('note-title').value = note.title;
        document.getElementById('note-content').value = note.content;
        
        document.getElementById('save-btn').innerText = 'Cập Nhật Ghi Chú';
        document.getElementById('cancel-btn').style.display = 'inline-block';
    }
}

// Xóa ghi chú (Delete)
function deleteNote(id) {
    if (confirm('Bạn có chắc chắn muốn xóa ghi chú này không?')) {
        let notes = getNotes();
        notes = notes.filter(note => note.id !== id);
        saveNotesToStorage(notes);
        renderNotes();
        resetForm();
    }
}

// Đặt lại form về trạng thái ban đầu
function resetForm() {
    document.getElementById('note-id').value = '';
    document.getElementById('note-title').value = '';
    document.getElementById('note-content').value = '';
    document.getElementById('save-btn').innerText = 'Thêm Ghi Chú';
    document.getElementById('cancel-btn').style.display = 'none';
}

// Hàm hỗ trợ chống XSS cơ bản khi render HTML
function escapeHTML(str) {
    return str.replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
    );
}
```

