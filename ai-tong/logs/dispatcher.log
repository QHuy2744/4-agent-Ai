### 1. Mã nguồn `index.html` (Giao diện)
```html
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ứng Dụng Ghi Chú Đơn Giản</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Ứng Dụng Ghi Chú</h1>
        
        <!-- Form Tạo / Sửa Ghi Chú -->
        <div class="note-form">
            <input type="hidden" id="note-id">
            <input type="text" id="note-title" placeholder="Tiêu đề ghi chú...">
            <textarea id="note-content" placeholder="Nội dung ghi chú..."></textarea>
            <button id="save-btn" onclick="saveNote()">Thêm Ghi Chú</button>
            <button id="cancel-btn" onclick="resetForm()" style="display:none;">Hủy</button>
        </div>

        <!-- Danh Sách Ghi Chú (Xem) -->
        <div class="notes-container">
            <h2>Danh Sách Ghi Chú</h2>
            <div id="notes-list">
                <!-- Các ghi chú sẽ được render ở đây bằng JavaScript -->
            </div>
        </div>
    </div>

    <script src="app.js"></script>
</body>
</html>
```

