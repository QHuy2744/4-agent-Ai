[AI TỔNG] Vai trò agent: Viết và sửa code

Chào hệ thống, tôi là **CODER**. Dựa trên kế hoạch của PLANNER và yêu cầu tạo ra Web bắn Free Fire, tôi xin tiến hành viết mã nguồn hoàn chỉnh cho trò chơi này dưới dạng một file HTML duy nhất (gồm HTML, CSS và JavaScript) để dễ dàng chạy trực tiếp trên trình duyệt.

Trò chơi bao gồm:
- **Giao diện Lobby (Sảnh chờ)** phong cách Free Fire với nút "BẮT ĐẦU TRẬN ĐẤU".
- **Giao diện HUD trong game:** Thanh máu (HP), số đạn, điểm số tiêu diệt (Kills).
- **Cơ chế Gameplay:** 
  - Di chuyển nhân vật bằng các phím `W, A, S, D`.
  - Ngắm và bắn theo hướng con trỏ chuột khi click trái.
  - Kẻ địch (Bot) tự động xuất hiện, di chuyển về phía người chơi và tấn công.
  - Va chạm giữa đạn và kẻ địch, tính điểm và trừ máu khi bị kẻ địch tiếp cận.

Dưới đây là mã nguồn hoàn chỉnh của ứng dụng:

```html
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Free Fire Web Edition</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }
        body {
            background-color: #1a1a1a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        #game-container {
            position: relative;
            width: 800px;
            height: 500px;
            background: #2c3e50;
            border: 4px solid #e74c3c;
            box-shadow: 0 0 20px rgba(231, 76, 60, 0.6);
            cursor: crosshair;
        }
        canvas {
            display: block;
            background: #1e272e;
        }
        /* Lobby Screen */
        #lobby {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #2c3e50, #000000);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }
        #lobby h1 {
            font-size: 48px;
            color: #f1c40f;
            text-shadow: 3px 3px #e74c3c;
            margin-bottom: 20px;
            letter-spacing: 2px;
        }
        #lobby p {
            font-size: 16px;
            color: #bdc3c7;
            margin-bottom: 30px;
            text-align: center;
            max-width: 500px;
        }
        .btn {
            background: #e74c3c;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 5px;
            transition: 0.2s;
            box-shadow: 0 4px #c0392b;
        }
        .btn:hover {
            background: #c0392b;
        }
        .btn:active {
            transform: translateY(4px);
            box-shadow: 0 0 #c0392b;
        }
        /* HUD Screen */
        #hud {
            position: absolute;
            top: 10px;
            left: 10px;
            right: 10px;
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: bold;
            z-index: 5;
            pointer-events: none;
            display: none;
        }
        .hud-item {
            background: rgba(0, 0, 0, 0.6);
            padding: 5px 15px;
            border-radius: 4px;
            border: 1px solid #f1c40f;
        }
        /* Game Over Screen */
        #gameover {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
            display: none;
        }
        #gameover h2 {
            font-size: 40px;
            color: #e74c3c;
            margin-bottom: 15px;
        }
        #gameover p {
            font-size: 20px;
            margin-bottom: 25px;
        }
    </style>
</head>
<body>

    <div id="game-container">
        <!-- Lobby -->
        <div id="lobby">
            <h1>FREE FIRE WEB</h1>
            <p>Dùng phím <b>W, A, S, D</b> để di chuyển.<br>Dùng <b>Chuột</b> để nhắm và <b>Click trái</b> để bắn hạ kẻ địch!</p>
            <button class="btn" onclick="startGame()">BẮT ĐẦU TRẬN</button>
        </div>

        <!-- HUD -->
        <div id="hud">
            <div class="hud-item" id="hp-display">Máu: 100</div>
            <div class="hud-item" id="kill-display">Hạ gục: 0</div>
        </div>

        <!-- Game Over -->
        <div id="gameover">
            <h2>BẠN ĐÃ BỊ HẠ GỤC</h2>
            <p id="final-score">Tiêu diệt: 0 kẻ địch</p>
            <button class="btn" onclick="startGame()">CHƠI LẠI</button>
        </div>

        <!-- Canvas Game -->
        <canvas id="gameCanvas" width="800" height="500"></canvas>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        let gameRunning = false;
        let score = 0;
        let health = 100;

        let player = {
            x: canvas.width / 2,
            y: canvas.height / 2,
            radius: 15,
            speed: 3,
            angle: 0
        };

        let keys = {};
        let mouse = { x: 0, y: 0 };
        let bullets = [];
        let enemies = [];
        let enemySpawnTimer = 0;

        // Lắng nghe sự kiện bàn phím & chuột
        window.addEventListener("keydown", (e) => keys[e.key.toLowerCase()] = true);
        window.addEventListener("keyup", (e) => keys[e.key.toLowerCase()] = false);
        canvas.addEventListener("mousemove", (e) => {
            let rect = canvas.getBoundingClientRect();
            mouse.x = e.clientX - rect.left;
            mouse.y = e.clientY - rect.top;
        });
        canvas.addEventListener("click", () => {
            if (!gameRunning) return;
            // Bắn đạn
            let angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);
            bullets.push({
                x: player.x,
                y: player.y,
                dx: Math.cos(angle) * 7,
                dy: Math.sin(angle) * 7,
                radius: 4
            });
        });

        function startGame() {
            document.getElementById("lobby").style.display = "none";
            document.getElementById("gameover").style.display = "none";
            document.getElementById("hud").style.display = "flex";
            
            gameRunning = true;
            score = 0;
            health = 100;
            player.x = canvas.width / 2;
            player.y = canvas.height / 2;
            bullets = [];
            enemies = [];
            enemySpawnTimer = 0;
            
            loop();
        }

        function spawnEnemy() {
            let edge = Math.floor(Math.random() * 4);
            let ex, ey;
            if (edge === 0) { ex = Math.random() * canvas.width; ey = -20; }
            else if (edge === 1) { ex = Math.random() * canvas.width; ey = canvas.height + 20; }
            else if (edge === 2) { ex = -20; ey = Math.random() * canvas.height; }
            else { ex = canvas.width + 20; ey = Math.random() * canvas.height; }

            enemies.push({
                x: ex,
                y: ey,
                radius: 12,
                speed: 1.5
            });
        }

        function update() {
            if (!gameRunning) return;

            // Di chuyển Player
            if (keys['w'] && player.y > player.radius) player.y -= player.speed;
            if (keys['s'] && player.y < canvas.height - player.radius) player.y += player.speed;
            if (keys['a'] && player.x > player.radius) player.x -= player.speed;
            if (keys['d'] && player.x < canvas.width - player.radius) player.x += player.speed;

            // Xoay hướng player theo chuột
            player.angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);

            // Cập nhật đạn
            for (let i = bullets.length - 1; i >= 0; i--) {
                bullets[i].x += bullets[i].dx;
                bullets[i].y += bullets[i].dy;

                // Xóa đạn ra ngoài màn hình
                if (bullets[i].x < 0 || bullets[i].x > canvas.width || bullets[i].y < 0 || bullets[i].y > canvas.height) {
                    bullets.splice(i, 1);
                }
            }

            // Sinh kẻ địch
            enemySpawnTimer++;
            if (enemySpawnTimer > 60) {
                spawnEnemy();
                enemySpawnTimer = 0;
            }

            // Cập nhật kẻ địch & va chạm
            for (let i = enemies.length - 1; i >= 0; i--) {
                let en = enemies[i];
                let angle = Math.atan2(player.y - en.y, player.x - en.x);
                en.x += Math.cos(angle) * en.speed;
                en.y += Math.sin(angle) * en.speed;

                // Va chạm kẻ địch với Player
                let distPlayer = Math.hypot(player.x - en.x, player.y - en.y);
                if (distPlayer < player.radius + en.radius) {
                    health -= 1;
                    if (health <= 0) {
                        gameOver();
                    }
                }

                // Va chạm đạn với kẻ địch
                for (let j = bullets.length - 1; j >= 0; j--) {
                    let b = bullets[j];
                    let distBullet = Math.hypot(b.x - en.x, b.y - en.y);
                    if (distBullet < b.radius + en.radius) {
                        enemies.splice(i, 1);
                        bullets.splice(j, 1);
                        score += 1;
                        break;
                    }
                }
            }

            // Cập nhật HUD
            document.getElementById("hp-display").innerText = `Máu: ${health}`;
            document.getElementById("kill-display").innerText = `Hạ gục: ${score}`;
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Vẽ Player
            ctx.save();
            ctx.translate(player.x, player.y);
            ctx.rotate(player.angle);
            ctx.fillStyle = "#3498db";
            ctx.beginPath();
            ctx.arc(0, 0, player.radius, 0, Math.PI * 2);
            ctx.fill();
            // Nòng súng
            ctx.fillStyle = "#2980b9";
            ctx.fillRect(0, -4, 20, 8);
            ctx.restore();

            // Vẽ đạn
            ctx.fillStyle = "#f1c40f";
            for (let b of bullets) {
                ctx.beginPath();
                ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
                ctx.fill();
            }

            // Vẽ kẻ địch
            ctx.fillStyle = "#e74c3c";
            for (let en of enemies) {
                ctx.beginPath();
                ctx.arc(en.x, en.y, en.radius, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function loop() {
            if (!gameRunning) return;
            update();
            draw();
            requestAnimationFrame(loop);
        }

        function gameOver() {
            gameRunning = false;
            document.getElementById("gameover").style.display = "flex";
            document.getElementById("hud").style.display = "none";
            document.getElementById("final-score").innerText = `Tiêu diệt: ${score} kẻ địch`;
        }
    </script>
</body>
</html>
```

