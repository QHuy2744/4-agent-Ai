diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..547504e
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,80 @@
+:root {
+    --bg-primary: #0f172a;
+    --bg-secondary: #1e293b;
+    --bg-tertiary: #334155;
+    --text-primary: #f8fafc;
+    --text-secondary: #94a3b8;
+    --accent: #3b82f6;
+    --accent-hover: #2563eb;
+    --danger: #ef4444;
+    --success: #22c55e;
+    --warning: #f59e0b;
+    --border: #475569;
+    --window-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.5);
+}
+[data-theme="light"] {
+    --bg-primary: #f1f5f9;
+    --bg-secondary: #ffffff;
+    --bg-tertiary: #e2e8f0;
+    --text-primary: #0f172a;
+    --text-secondary: #64748b;
+    --accent: #2563eb;
+    --accent-hover: #1d4ed8;
+    --border: #cbd5e1;
+    --window-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
+}
+* { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
+body, html { width: 100%; height: 100%; overflow: hidden; background: var(--bg-primary); color: var(--text-primary); }
+#app-root { width: 100%; height: 100%; display: flex; flex-direction: column; position: relative; }
+#desktop-background { flex: 1; position: relative; padding: 20px; display: grid; grid-template-columns: repeat(auto-fill, 90px); grid-auto-rows: 90px; gap: 15px; overflow: auto; }
+.desktop-icon { display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255,255,255,0.05); border-radius: 8px; cursor: pointer; padding: 10px; transition: background 0.2s; border: 1px solid transparent; }
+.desktop-icon:hover { background: rgba(255,255,255,0.1); border-color: var(--border); }
+.desktop-icon svg { width: 32px; height: 32px; margin-bottom: 6px; color: var(--accent); }
+.desktop-icon span { font-size: 12px; text-align: center; color: var(--text-primary); word-break: break-all; }
+#shell-topbar { height: 40px; background: var(--bg-secondary); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 15px; z-index: 1000; }
+.tray-left, .tray-right { display: flex; align-items: center; gap: 10px; }
+.tray-btn { background: transparent; border: none; color: var(--text-primary); padding: 5px 10px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; gap: 6px; font-size: 13px; }
+.tray-btn:hover { background: var(--bg-tertiary); }
+.badge { background: var(--danger); color: white; padding: 1px 6px; border-radius: 10px; font-size: 10px; }
+#shell-taskbar { height: 45px; background: var(--bg-secondary); border-top: 1px solid var(--border); display: flex; align-items: center; padding: 0 10px; gap: 5px; z-index: 1000; overflow-x: auto; }
+.taskbar-item { padding: 6px 14px; background: var(--bg-tertiary); border: 1px solid var(--border); border-radius: 4px; color: var(--text-primary); cursor: pointer; font-size: 12px; display: flex; align-items: center; gap: 6px; white-space: nowrap; }
+.taskbar-item.active { border-color: var(--accent); background: var(--accent); color: white; }
+#window-container { position: absolute; top: 40px; left: 0; right: 0; bottom: 45px; pointer-events: none; overflow: hidden; }
+.window { position: absolute; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; box-shadow: var(--window-shadow); display: flex; flex-direction: column; pointer-events: auto; overflow: hidden; min-width: 300px; min-height: 200px; }
+.window.minimized { display: none; }
+.window-header { height: 35px; background: var(--bg-tertiary); display: flex; align-items: center; justify-content: space-between; padding: 0 10px; cursor: move; user-select: none; }
+.window-title { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
+.window-controls { display: flex; gap: 5px; }
+.win-ctrl-btn { width: 22px; height: 22px; border: none; border-radius: 4px; background: transparent; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 12px; }
+.win-ctrl-btn:hover { background: rgba(255,255,255,0.2); }
+.win-ctrl-btn.close:hover { background: var(--danger); color: white; }
+.window-body { flex: 1; overflow: auto; padding: 15px; display: flex; flex-direction: column; gap: 10px; position: relative; }
+.hidden { display: none !important; }
+#launcher-menu, #notification-center, #command-palette, #lock-screen, #global-error-boundary { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; }
+#launcher-menu { justify-content: flex-start; align-items: flex-start; padding: 60px 20px; }
+.launcher-search, .palette-box { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; width: 600px; max-width: 100%; padding: 15px; box-shadow: var(--window-shadow); }
+.launcher-search input, .palette-box input { width: 100%; padding: 10px; background: var(--bg-primary); border: 1px solid var(--border); color: var(--text-primary); border-radius: 4px; font-size: 14px; }
+.launcher-apps { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 15px; margin-top: 20px; width: 600px; max-width: 100%; }
+#notification-center { justify-content: flex-start; align-items: flex-end; padding: 50px 20px; background: transparent; pointer-events: none; }
+#notification-center > div:not(.notif-header) { pointer-events: auto; }
+.notif-box { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; width: 350px; max-height: 500px; display: flex; flex-direction: column; box-shadow: var(--window-shadow); pointer-events: auto; }
+.notif-header { padding: 12px 15px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
+#notif-list { flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
+.notif-item { background: var(--bg-primary); padding: 10px; border-radius: 6px; border: 1px solid var(--border); font-size: 12px; }
+.lock-box, .error-box { background: var(--bg-secondary); padding: 30px; border-radius: 12px; border: 1px solid var(--border); text-align: center; width: 400px; display: flex; flex-direction: column; gap: 15px; }
+.lock-box input { padding: 10px; font-size: 18px; text-align: center; background: var(--bg-primary); border: 1px solid var(--border); color: var(--text-primary); border-radius: 6px; }
+button { padding: 8px 16px; background: var(--accent); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 550; }
+button:hover { background: var(--accent-hover); }
+input, select, textarea { background: var(--bg-primary); border: 1px solid var(--border); color: var(--text-primary); padding: 6px 10px; border-radius: 4px; }
+table { width: 100%; border-collapse: collapse; font-size: 13px; }
+th, td { border: 1px solid var(--border); padding: 8px; text-align: left; }
+th { background: var(--bg-tertiary); }
+.terminal-output { background: #000; color: #00ff00; font-family: monospace; padding: 10px; flex: 1; overflow-y: auto; border-radius: 4px; border: 1px solid var(--border); }
+.terminal-input-line { display: flex; gap: 5px; margin-top: 5px; }
+.terminal-input-line input { flex: 1; background: #000; color: #00ff00; border: none; font-family: monospace; }
+.spreadsheet-grid { display: grid; grid-template-columns: 50px repeat(10, 100px); grid-auto-rows: 25px; overflow: auto; border: 1px solid var(--border); }
+.ss-cell { border: 1px solid var(--border); padding: 2px 5px; font-size: 12px; background: var(--bg-primary); overflow: hidden; white-space: nowrap; }
+.ss-cell:focus { outline: 1px solid var(--accent); background: var(--bg-secondary); }
+@media(max-width: 768px) {
+    .window { top: 0 !important; left: 0 !important; width: 100% !important; height: calc(100% - 85px) !important; border-radius: 0; }
+}
